{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shillcraft-pos-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "no_handle_cross_request_promise_resolution"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "shillcraft-pos-staging" }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1d742e2981d94953990d1e785241f1ca",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
    }
  ]
}
