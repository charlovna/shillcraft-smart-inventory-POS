// ShillCraft POS schema (Phase 2). Source: docs/SPEC.md.
// RLS, roles and grants live in hand-written SQL migrations, not here.
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  owner
  cashier
}

enum OrderStatus {
  new
  accepted
  ready
  completed
  voided
  declined
  expired
}

enum OrderSource {
  counter
  qr
}

enum OrderType {
  dine_in
  take_out
}

enum DiscountType {
  percent
  fixed
}

enum MovementType {
  sale
  void
  restock
  adjust
  waste
  count
}

model Business {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String
  logoUrl          String?          @map("logo_url")
  currency         String           @default("PHP")
  timeZone         String           @default("Asia/Manila") @map("time_zone")
  receiptHeader    String?          @map("receipt_header")
  receiptFooter    String?          @map("receipt_footer")
  defaultOrderType OrderType        @default(dine_in) @map("default_order_type")
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  locations        Location[]
  users            User[]
  paymentMethods   PaymentMethod[]
  categorys        Category[]
  products         Product[]
  productAddons    ProductAddon[]
  stockItems       StockItem[]
  recipeLines      RecipeLine[]
  locationStocks   LocationStock[]
  shifts           Shift[]
  orders           Order[]
  orderItems       OrderItem[]
  stockMovements   StockMovement[]
  orderRateLimits  OrderRateLimit[]

  @@map("businesses")
}

model Location {
  id                    String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId            String           @map("business_id") @db.Uuid
  business              Business         @relation(fields: [businessId], references: [id])
  name                  String
  address               String?
  menuCode              String           @unique @map("menu_code")
  onlineOrderingEnabled Boolean          @default(false) @map("online_ordering_enabled")
  tableLabels           String[]         @default([]) @map("table_labels")
  active                Boolean          @default(true)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  users                 User[]
  locationStocks        LocationStock[]
  shifts                Shift[]
  orders                Order[]
  stockMovements        StockMovement[]
  orderRateLimits       OrderRateLimit[]

  @@unique([businessId, id])
  @@index([businessId])
  @@map("locations")
}

model User {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String          @map("business_id") @db.Uuid
  business       Business        @relation(fields: [businessId], references: [id])
  authUserId     String          @unique @map("auth_user_id") @db.Uuid
  name           String
  email          String
  role           Role
  locationId     String?         @map("location_id") @db.Uuid
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  location       Location?       @relation(fields: [businessId, locationId], references: [businessId, id])
  shifts         Shift[]
  orders         Order[]
  stockMovements StockMovement[]

  @@unique([businessId, id])
  @@unique([businessId, email])
  @@index([businessId])
  @@index([locationId])
  @@map("users")
}

model PaymentMethod {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  business       Business @relation(fields: [businessId], references: [id])
  name           String
  qrImageUrl     String?  @map("qr_image_url")
  needsReference Boolean  @default(false) @map("needs_reference")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  orders         Order[]

  @@unique([businessId, id])
  @@index([businessId])
  @@map("payment_methods")
}

model Category {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId String    @map("business_id") @db.Uuid
  business   Business  @relation(fields: [businessId], references: [id])
  name       String
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  products   Product[]

  @@unique([businessId, id])
  @@index([businessId])
  @@map("categories")
}

model Product {
  id                         String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                 String         @map("business_id") @db.Uuid
  business                   Business       @relation(fields: [businessId], references: [id])
  categoryId                 String?        @map("category_id") @db.Uuid
  name                       String
  priceCentavos              Int            @map("price_centavos")
  isAddon                    Boolean        @default(false) @map("is_addon")
  active                     Boolean        @default(true)
  createdAt                  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  category                   Category?      @relation(fields: [businessId, categoryId], references: [businessId, id])
  productAddons              ProductAddon[] @relation("AddonOffers")
  productAddons_addonProduct ProductAddon[] @relation("AddonOf")
  recipeLines                RecipeLine[]
  orderItems                 OrderItem[]

  @@unique([businessId, id])
  @@index([businessId])
  @@index([categoryId])
  @@map("products")
}

model ProductAddon {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  business       Business @relation(fields: [businessId], references: [id])
  productId      String   @map("product_id") @db.Uuid
  addonProductId String   @map("addon_product_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product        Product  @relation("AddonOffers", fields: [businessId, productId], references: [businessId, id])
  addonProduct   Product  @relation("AddonOf", fields: [businessId, addonProductId], references: [businessId, id])

  @@unique([businessId, id])
  @@unique([productId, addonProductId])
  @@index([businessId])
  @@index([productId])
  @@index([addonProductId])
  @@map("product_addons")
}

model StockItem {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId           String          @map("business_id") @db.Uuid
  business             Business        @relation(fields: [businessId], references: [id])
  name                 String
  baseUnit             String          @map("base_unit")
  purchaseUnit         String?         @map("purchase_unit")
  purchaseToBaseFactor Decimal?        @map("purchase_to_base_factor") @db.Decimal(14, 4)
  reorderLevel         Decimal         @default(0) @map("reorder_level") @db.Decimal(14, 3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  recipeLines          RecipeLine[]
  locationStocks       LocationStock[]
  stockMovements       StockMovement[]

  @@unique([businessId, id])
  @@index([businessId])
  @@map("stock_items")
}

model RecipeLine {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId    String    @map("business_id") @db.Uuid
  business      Business  @relation(fields: [businessId], references: [id])
  productId     String    @map("product_id") @db.Uuid
  stockItemId   String    @map("stock_item_id") @db.Uuid
  qtyPerServing Decimal   @map("qty_per_serving") @db.Decimal(14, 4)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  product       Product   @relation(fields: [businessId, productId], references: [businessId, id])
  stockItem     StockItem @relation(fields: [businessId, stockItemId], references: [businessId, id])

  @@unique([businessId, id])
  @@unique([productId, stockItemId])
  @@index([businessId])
  @@index([productId])
  @@index([stockItemId])
  @@map("recipe_lines")
}

model LocationStock {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId                 String    @map("business_id") @db.Uuid
  business                   Business  @relation(fields: [businessId], references: [id])
  locationId                 String    @map("location_id") @db.Uuid
  stockItemId                String    @map("stock_item_id") @db.Uuid
  onHand                     Decimal   @default(0) @map("on_hand") @db.Decimal(14, 3)
  avgCostCentavosPerBaseUnit Decimal   @default(0) @map("avg_cost_centavos_per_base_unit") @db.Decimal(14, 6)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  location                   Location  @relation(fields: [businessId, locationId], references: [businessId, id])
  stockItem                  StockItem @relation(fields: [businessId, stockItemId], references: [businessId, id])

  @@unique([businessId, id])
  @@unique([locationId, stockItemId])
  @@index([businessId])
  @@index([locationId])
  @@index([stockItemId])
  @@map("location_stock")
}

model Shift {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  business     Business  @relation(fields: [businessId], references: [id])
  locationId   String    @map("location_id") @db.Uuid
  cashierId    String    @map("cashier_id") @db.Uuid
  openedAt     DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(6)
  startingCash Int       @map("starting_cash")
  expectedCash Int?      @map("expected_cash")
  countedCash  Int?      @map("counted_cash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  location     Location  @relation(fields: [businessId, locationId], references: [businessId, id])
  cashier      User      @relation(fields: [businessId, cashierId], references: [businessId, id])
  orders       Order[]

  @@unique([businessId, id])
  @@index([businessId])
  @@index([locationId])
  @@index([cashierId])
  @@map("shifts")
}

model Order {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId        String          @map("business_id") @db.Uuid
  business          Business        @relation(fields: [businessId], references: [id])
  locationId        String          @map("location_id") @db.Uuid
  clientSaleId      String          @map("client_sale_id") @db.Uuid
  source            OrderSource     @default(counter)
  status            OrderStatus     @default(completed)
  orderType         OrderType       @default(dine_in) @map("order_type")
  tableLabel        String?         @map("table_label")
  customerFirstName String?         @map("customer_first_name")
  cashierId         String?         @map("cashier_id") @db.Uuid
  shiftId           String?         @map("shift_id") @db.Uuid
  discountType      DiscountType?   @map("discount_type")
  discountValue     Int?            @map("discount_value")
  discountCentavos  Int             @default(0) @map("discount_centavos")
  totalCentavos     Int             @default(0) @map("total_centavos")
  paymentMethodId   String?         @map("payment_method_id") @db.Uuid
  paymentReference  String?         @map("payment_reference")
  completedAt       DateTime?       @map("completed_at") @db.Timestamptz(6)
  voidReason        String?         @map("void_reason")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  location          Location        @relation(fields: [businessId, locationId], references: [businessId, id])
  cashier           User?           @relation(fields: [businessId, cashierId], references: [businessId, id])
  shift             Shift?          @relation(fields: [businessId, shiftId], references: [businessId, id])
  paymentMethod     PaymentMethod?  @relation(fields: [businessId, paymentMethodId], references: [businessId, id])
  orderItems        OrderItem[]
  stockMovements    StockMovement[]

  @@unique([businessId, id])
  @@unique([businessId, clientSaleId])
  @@index([businessId])
  @@index([locationId, status, createdAt])
  @@index([locationId])
  @@index([cashierId])
  @@index([shiftId])
  @@index([paymentMethodId])
  @@map("orders")
}

model OrderItem {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId          String      @map("business_id") @db.Uuid
  business            Business    @relation(fields: [businessId], references: [id])
  orderId             String      @map("order_id") @db.Uuid
  productId           String      @map("product_id") @db.Uuid
  parentItemId        String?     @map("parent_item_id") @db.Uuid
  qty                 Int
  priceAtSaleCentavos Int         @map("price_at_sale_centavos")
  costAtSaleCentavos  Int         @default(0) @map("cost_at_sale_centavos")
  note                String?
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  order               Order       @relation(fields: [businessId, orderId], references: [businessId, id])
  product             Product     @relation(fields: [businessId, productId], references: [businessId, id])
  parentItem          OrderItem?  @relation("ItemAddons", fields: [businessId, parentItemId], references: [businessId, id])
  children            OrderItem[] @relation("ItemAddons")

  @@unique([businessId, id])
  @@index([businessId])
  @@index([orderId])
  @@index([productId])
  @@index([parentItemId])
  @@map("order_items")
}

model StockMovement {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String       @map("business_id") @db.Uuid
  business    Business     @relation(fields: [businessId], references: [id])
  locationId  String       @map("location_id") @db.Uuid
  stockItemId String       @map("stock_item_id") @db.Uuid
  type        MovementType
  qtyChange   Decimal      @map("qty_change") @db.Decimal(14, 3)
  unitCost    Decimal?     @map("unit_cost") @db.Decimal(14, 6)
  userId      String?      @map("user_id") @db.Uuid
  reason      String?
  orderId     String?      @map("order_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  location    Location     @relation(fields: [businessId, locationId], references: [businessId, id])
  stockItem   StockItem    @relation(fields: [businessId, stockItemId], references: [businessId, id])
  user        User?        @relation(fields: [businessId, userId], references: [businessId, id])
  order       Order?       @relation(fields: [businessId, orderId], references: [businessId, id])

  @@unique([businessId, id])
  @@index([businessId])
  @@index([stockItemId, createdAt])
  @@index([locationId])
  @@index([stockItemId])
  @@index([userId])
  @@index([orderId])
  @@map("stock_movements")
}

model OrderRateLimit {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  businessId  String   @map("business_id") @db.Uuid
  business    Business @relation(fields: [businessId], references: [id])
  locationId  String   @map("location_id") @db.Uuid
  deviceHash  String   @map("device_hash")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  location    Location @relation(fields: [businessId, locationId], references: [businessId, id])

  @@unique([businessId, id])
  @@unique([locationId, deviceHash, windowStart])
  @@index([businessId])
  @@index([locationId])
  @@map("order_rate_limits")
}
