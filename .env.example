# Copy to .env.local for local development. Never commit real values.
# Staging and production values live in Cloudflare (wrangler secrets) and GitHub secrets for now, and in Vercel env vars at production. Never in git.

# App runtime: pooled connection (transaction mode) as the RLS-bound runtime role (no BYPASSRLS)
DATABASE_URL="postgresql://app_runtime:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Migrations only: direct connection as the table owner (used by CI, never by the running app)
DIRECT_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres"

# Supabase Auth (staff login only; the Data API is disabled)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Server only. Never expose to the browser. Used by operator scripts.
SUPABASE_SECRET_KEY="sb_secret_..."

# Error tracking
SENTRY_DSN=""

# Public base URL used when printing customer QR codes
APP_BASE_URL="http://localhost:3000"

# Supabase project URLs (public, not secret)
#   staging:    https://yhbmkvmmlhtnblswsgup.supabase.co
#   production: https://wewclmbtzsoqgspfnndo.supabase.co
